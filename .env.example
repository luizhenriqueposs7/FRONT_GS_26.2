# Groq: copie este arquivo para .env e preencha a chave, sem publicá-la.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Para a entrega mantenha false. true usa regras, sem chamar um LLM.
DEMO_MODE=false

# Chave exclusiva da área de gestão da demonstração.
MANAGER_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Em produção, configure a URL exata do front-end permitido.
CORS_ORIGINS=http://localhost:8501

API_BASE_URL=http://localhost:8000
DATABASE_PATH=data/zelabairro.db
